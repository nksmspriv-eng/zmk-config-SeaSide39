#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

//以下USキーボードのままJISキーボードとして使うための定義 https://note.com/kloir_z/n/n314e739f03a1

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

//レイヤー0（PC用 デフォルトレイヤー）[cite: 1]

        default_layer {
            bindings = <
&kp Q       &kp W         &kp E             &kp R               &kp T                                           &kp Y        &kp U                &kp I              &kp O            &kp P
&kp A       &mt LALT S    &mt LEFT_SHIFT D  &mt LEFT_CONTROL F  &kp G                                           &kp H        &mt RIGHT_CONTROL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &kp MINUS
&kp Z       &kp X         &kp C             &kp V               &kp B                                           &kp N        &kp M                &kp COMMA          &kp PERIOD       &kp DELETE
&kp ESCAPE  &kp LEFT_GUI  &kp TAB           &kp GRAVE           &lt 1 SPACE  &lt 3 BACKSPACE      &lt 3 SLASH   &lt 2 ENTER                                                           &lt 4 RC(SPACE)
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

//レイヤー1（PC用 SYMBOL：JIS記号系、マウスクリック系）[cite: 1]

        SYMBOL {
            bindings = <
&kp EXCLAMATION   &kp JP_DQUOTE  &kp HASH          &kp DOLLAR       &kp PERCENT                       &kp JP_CARET  &kp JP_TILDE  &kp JP_PIPE  &kp JP_BACKQUOTE  &kp F5
&kp JP_AMPERSAND  &kp JP_QUOTE   &kp JP_LPAREN     &kp JP_RPAREN    &kp JP_AT                         &kp F6        &mkp LCLK     &mkp MCLK    &mkp RCLK         &kp F7
&kp SEMICOLON     &kp JP_COLON   &kp JP_LBRACKET   &kp JP_RBRACKET  &kp QUESTION                      &mkp MB4      &mkp MB5      &kp F8       &kp F9            &kp F10
&trans            &kp LESS_THAN  &kp GREATER_THAN  &trans           &trans        &trans      &trans  &trans                                                     &trans
            >;
        };

//レイヤー2（PC用 NUM：数字系）[cite: 1]
// ※右端中段を DELETE から SLASH に戻しています

        NUM {
            bindings = <
&kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                          &kp NUMBER_6      &kp N7       &kp N8     &kp N9           &kp N0
&kp JP_UNDERSCORE  &kp LEFT      &kp UP        &kp RIGHT     &kp JP_YEN                      &kp JP_EQUAL      &kp JP_PLUS  &kp MINUS  &kp JP_ASTERISK  &kp SLASH
&kp QMARK          &kp F1        &kp DOWN      &kp F3        &kp F4                          &kp RC(NUMBER_1)  &kp RC(V)    &kp RC(X)  &kp RC(S)        &kp RC(COLON)
&trans             &trans        &trans        &trans        &trans      &trans      &trans  &trans                                                     &kp PRINTSCREEN
            >;
        };

//レイヤー3（PC用 ARROW：矢印とファンクション系）[cite: 1]

        ARROW {
            bindings = <
&kp ESCAPE      &mkp MB4                &kp UP_ARROW    &mkp MB5                 &trans                       &kp F1   &kp F2   &kp F3         &kp F4                   &kp F5
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END                      &kp F6   &kp F7   &kp F8         &kp F9                   &kp F10
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans                       &kp F11  &kp F12  &kp LA(LG(F))  &kp RG(RA(RIGHT_ARROW))  &kp RA(RC(RG(RIGHT_ARROW)))
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

//レイヤー4（設定系：PC/iPad切り替え ＋ 片手モード切替・復帰）[cite: 1]

        MOUSE {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &bt BT_CLR  &trans     &trans     &trans     &trans
&to 0         &to 5         &trans        &trans        &trans                            &trans      &to 0      &mkp MCLK  &mkp RCLK  &trans
&trans        &trans        &trans        &trans        &trans                            &to 9       &to 0      &trans     &trans     &trans
&bootloader   &trans        &trans        &trans        &trans        &trans      &trans  &trans                                       &trans
            >;
        };

//レイヤー5（iPad用 デフォルトレイヤー）[cite: 1]

        IPAD_DEFAULT {
            bindings = <
&kp Q       &kp W         &kp E             &kp R               &kp T                                           &kp Y        &kp U                &kp I              &kp O            &kp P
&kp A       &mt LALT S    &mt LEFT_SHIFT D  &mt LEFT_CONTROL F  &kp G                                           &kp H        &mt RIGHT_CONTROL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &kp MINUS
&kp Z       &kp X         &kp C             &kp V               &kp B                                           &kp N        &kp M                &kp COMMA          &kp PERIOD       &kp DELETE
&kp ESCAPE  &kp LEFT_GUI  &kp TAB           &kp RC(SPACE)       &lt 6 SPACE  &lt 8 BACKSPACE      &lt 8 SLASH   &lt 7 ENTER                                                           &to 4
            >;
        };

//レイヤー6（iPad用 SYMBOL）[cite: 1]

        IPAD_SYMBOL {
            bindings = <
&kp EXCLAMATION   &kp DOUBLE_QUOTES  &kp HASH             &kp DOLLAR        &kp PERCENT                       &kp CARET         &kp TILDE         &kp PIPE          &kp GRAVE         &kp F5
&kp AMPERSAND     &kp SINGLE_QUOTE   &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp AT                        &kp F6            &mkp LCLK         &mkp MCLK         &mkp RCLK         &kp F7
&kp SEMICOLON     &kp COLON          &kp LEFT_BRACKET     &kp RIGHT_BRACKET &kp QUESTION                      &mkp MB4          &mkp MB5          &kp F8            &kp F9            &kp F10
&trans            &kp LESS_THAN      &kp GREATER_THAN     &trans            &trans        &trans      &trans  &trans                                                                  &trans
            >;
        };

//レイヤー7（iPad用 NUM）[cite: 1]
// ※右端中段を DELETE から SLASH に戻しています

        IPAD_NUM {
            bindings = <
&kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                          &kp NUMBER_6      &kp N7     &kp N8     &kp N9        &kp N0
&kp UNDERSCORE &kp LEFT      &kp UP        &kp RIGHT     &kp BACKSLASH                   &kp EQUAL         &kp PLUS   &kp MINUS  &kp ASTERISK  &kp SLASH
&kp QMARK      &kp F1        &kp DOWN      &kp F3        &kp F4                          &kp RC(NUMBER_1)  &kp RC(V)  &kp RC(X)  &kp RC(S)     &kp RC(COLON)
&trans         &trans        &trans        &trans        &trans      &trans      &trans  &trans                                                &kp PRINTSCREEN
            >;
        };

//レイヤー8（iPad用 ARROW）[cite: 1]

        IPAD_ARROW {
            bindings = <
&kp ESCAPE      &mkp MB4                &kp UP_ARROW    &mkp MB5                 &trans                       &kp F1   &kp F2   &kp F3         &kp F4                   &kp F5
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END                      &kp F6   &kp F7   &kp F8         &kp F9                   &kp F10
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans                       &kp F11  &kp F12  &kp LA(LG(F))  &kp RG(RA(RIGHT_ARROW))  &kp RA(RC(RG(RIGHT_ARROW)))
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

//レイヤー9（PC用 右手片手モード：ベース）[cite: 1]

        ONEHAND_BASE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp E           &kp I         &kp A        &kp O        &kp U
&trans  &trans  &trans  &trans  &trans                      &kp SPACE       &mkp LCLK     &mkp MCLK    &mkp RCLK    &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans                      &kp Z           &kp X         &kp C        &kp V        &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans      &lt 10 SLASH    &lt 11 ENTER                                    &lt 4 RC(SPACE)
            >;
        };

//レイヤー10（PC用 右手片手モード：大西配列 右手側子音）[cite: 1]

        ONEHAND_CONS {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp F       &kp W       &kp R       &kp Y       &kp P
&trans  &trans  &trans  &trans  &trans                      &kp K       &kp T       &kp N       &kp S       &kp H
&trans  &trans  &trans  &trans  &trans                      &kp G       &kp D       &kp M       &kp J       &kp B
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp ENTER                                       &lt 4 RC(SPACE)
            >;
        };

//レイヤー11（PC用 右手片手モード：数字 ＋ QLU ＋ スクロール）[cite: 1]

        ONEHAND_NUM_SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5
&trans  &trans  &trans  &trans  &trans                      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
&trans  &trans  &trans  &trans  &trans                      &kp Q       &kp L       &kp U       &kp SPACE   &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans  &trans      &kp SLASH   &trans                                      &lt 4 RC(SPACE)
            >;
        };
    };
};

//トラックボールのスクロール設定（レイヤー3、8、11に適用）[cite: 1]
&trackball_listener {
    scroller {
        layers = <3 8 11>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_scaler 1 1000 /* スクロール量 1/1000 */
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
        >;
    };
};
